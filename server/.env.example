# 小程序云函数 hrmsClient 用；HRMS 侧优先级 MINIPROGRAM_SYNC_SECRET || HRMS_GROWTH_EVENT_SECRET（注意 TCB 端优先级相反）
MINIPROGRAM_SYNC_SECRET=
MINIPROGRAM_SIGNATURE_REQUIRED=
HRMS_AGENT_V1_ENABLED=


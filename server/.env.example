# GAAS(hrms-service) 环境变量清单 —— 仅变量名，无真实值。
# 用法：cp server/.env.example server/.env，再填入真实值（不要提交 .env 到 git）。
# 完整变量名由 `grep -rhoE "process\.env\.[A-Z_][A-Z0-9_]*" server` 生成（2026-07-28）。
# 标 [必需] 的是本地跑起服务的最小集合；其余多数有默认值或只在对应功能启用时才需要。
# 密钥轮换流程见 docs/key-rotation-runbook.md；共享表/跨仓协作见根 CLAUDE.md。

# ==================== 核心 [必需] ====================
DATABASE_URL=
JWT_SECRET=
PORT=3000
# development | production；production 会跳过 listen-time DDL，改用 `npm run migrate`
APP_ENV=development
NODE_ENV=development

# ==================== 管理员账号 ====================
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_REAL_NAME=
AGENTS_ADMIN_USERNAME=
AGENTS_ADMIN_PASSWORD=

# ==================== 平台/租户级 JWT & 密钥 ====================
PLATFORM_ADMIN_JWT_SECRET=
PLATFORM_ADMIN_SECRET=
AGENTS_JWT_SECRET=
HRMS_JWT_SECRET=
# AES-256-GCM，须能 decode 出恰好 32 字节，用于 tenant_integrations.encrypted_config
TENANT_INTEGRATION_ENCRYPTION_KEY=
TENANT_MODE=
TENANT_ID=
DEMO_TENANT_ID=
DEMO_STORE_ID=
HRMS_ALLOWED_TENANT_IDS=
LICENSE_ENFORCE=
LICENSE_ENFORCE_EXEMPT_TENANTS=

# ==================== agents-service-v2 互联 ====================

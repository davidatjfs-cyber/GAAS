# HRMS 数据库备份基线：每日全租户 state + 每周 PostgreSQL 逻辑全量。
# 安装时请合并到现有 root crontab，不要整文件覆盖其它业务任务。
#
# 服务端（ECS root crontab，时区上海）：
# CRON_TZ=Asia/Shanghai
CRON_TZ=Asia/Shanghai
0 12 * * * /usr/bin/flock -n /var/lock/hrms-state-backup.lock /bin/bash /opt/hrms/server/backup-state-only.sh
0 3 * * 0 /usr/bin/flock -n /var/lock/hrms-full-backup.lock /bin/bash /opt/hrms/server/backup.sh
#
# Mac 本机自动拉取周备（推荐：每周一 23:00，无需手跑命令）
#   bash scripts/mac-launchd/install-weekly-pull-launchagent.sh
# 或手动（测试）：
# HRMS_MAC_BACKUP_DIR="/Users/magainze/hrms backup" bash /path/to/HRMS/scripts/pull-hrms-weekly-backup.sh
#
# 注意：WAL-PITR 是独立增强项；必须验证 archive_mode=on、archive_command、base backup 和恢复演练后才算启用。

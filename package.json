{
  "name": "hr-management-system",
  "private": true,
  "packageManager": "npm@10.2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "server",
    "packages/gaas-shared"
  ],
  "scripts": {
    "start": "npm --workspace server run start",
    "migrate": "npm --workspace server run migrate",
    "seed:growth-demo": "npm --workspace server run seed:growth-demo",
    "assert:ci-runtime": "node scripts/assert-ci-runtime.mjs",
    "test": "npm run assert:ci-runtime && npm --workspace server run test",
    "test:coverage": "npm run assert:ci-runtime && npm --workspace server run test:coverage",
    "test:coverage:merged": "npm run assert:ci-runtime && npm --workspace server run test:coverage:merged",
    "lint": "eslint \"server/**/*.js\" \"server/**/*.mjs\" --max-warnings 80",
    "bundle:frontend": "node scripts/bundle-frontend.mjs",
    "build:shell": "node scripts/build-shell.mjs",
    "compare:prod-frontend": "node scripts/compare-prod-frontend.mjs",
    "deploy:frontend": "bash scripts/deploy-frontend.sh",
    "deploy:server": "bash scripts/deploy-server-files.sh",
    "deploy:prod-deps": "bash scripts/install-prod-deps.sh",
    "deploy:prod-deps:verify": "VERIFY_ONLY=1 bash scripts/install-prod-deps.sh",
    "deploy:check": "bash scripts/deploy-hrms-safe.sh",
    "secrets:verify": "bash scripts/verify-secret-presence.sh"
  },
  "dependencies": {
    "mammoth": "^1.12.0"
  },
  "devDependencies": {
    "dompurify": "^3.2.6",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0"
  }
}
